# Copy to .env and adjust. Never commit .env.

# "claude" (Anthropic API, paid) or "ollama" (local, free)
LLM_PROVIDER=ollama

# Claude: set ANTHROPIC_API_KEY in your environment, or run `ant auth login`.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Ollama: install from https://ollama.com, then `ollama pull qwen2.5:3b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
